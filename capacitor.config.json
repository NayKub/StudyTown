{
  "appId": "com.example.studytown",
  "appName": "My Little Town",
  "webDir": "dist",
  "backgroundColor": "#fdf3e7",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#fdf3e7",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "LIGHT"
    },
    "LocalNotifications": {
      "iconColor": "#ff8fab"
    }
  }
}
