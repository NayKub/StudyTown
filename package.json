{
  "name": "study-town-app",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#bfe6ff' --iconBackgroundColorDark '#2b2d5c' --splashBackgroundColor '#fdf3e7' --splashBackgroundColorDark '#2b2d5c'",
    "dev:mock": "VITE_CLOUD_MOCK=1 vite",
    "build:mock": "VITE_CLOUD_MOCK=1 vite build --outDir dist-mock",
    "test:rules": "firebase emulators:exec --only firestore --project demo-studytown 'node --test tests/rules.test.mjs'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/mali": "^5.3.0",
    "firebase": "^13.2.0",
    "i18next": "^27.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
